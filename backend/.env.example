APP_NAME=HRIMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# Browser URLs stay /api/v1/... . If Apache Alias /api strips that prefix (NTC VM),
# Laravel also matches v1/... (see bootstrap/app.php apiPrefix). No extra env needed.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrims_dev
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated hosts (no https://). Must include the SPA host or Sanctum skips session on /api (login breaks).
# APP_URL / FRONTEND_URL hosts are merged automatically in AppServiceProvider; extend here for extra hosts (e.g. www).
# Must include the live SPA host (e.g. hrims.mohr.gov.pk) or /api/v1/auth/me returns 401.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

# Use file on simple hosting unless you have run session/cache migrations (php artisan session:table / cache:table).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Must be null when users open the app by IP (e.g. http://10.2.43.130). A hostname here will not stick on IP.
SESSION_DOMAIN=null
# false for http:// IP access. true only when the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# IMPORTANT: sync + real SMTP sends every email inside the HTTP request.
# That can leave form buttons stuck on "Submitting…" on production even though
# the record was already saved. Prefer database/redis queue + `php artisan queue:work`,
# or MAIL_MAILER=log for local. Controllers also defer notify/mail afterResponse.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production SMTP (mail.hrims.pk). Local/dev should use MAIL_MAILER=log.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.hrims.pk
MAIL_PORT=465
MAIL_USERNAME=hrims@hrims.pk
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hrims@hrims.pk
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_EMAIL=hrims@hrims.pk

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
