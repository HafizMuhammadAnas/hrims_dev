# SPA fallback for Apache (production). Without this, hard refresh on deep links
# (e.g. /catalog-mgmt/issues) returns 404/500 — FortiGate may then show "Web Page Blocked".
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Existing files (assets, favicon, knowledge PDFs, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /api is usually Aliased to Laravel — do not rewrite here if Alias is configured
    RewriteRule ^api/ - [L]

    # Client-side routes → shell
    RewriteRule ^ index.html [L]
</IfModule>
